{
  "name": "sonicflow",
  "version": "1.2.0",
  "private": true,
  "description": "SonicFlow — Next-Gen Cross-Platform Music Player with SoundCloud integration, synced lyrics and customizable themes",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "build:exe": "npm run build && C:\\Windows\\Microsoft.NET\\Framework64\\v4.0.30319\\csc.exe /target:winexe /optimize+ /platform:anycpu /out:SonicFlow.exe /win32icon:app.ico /r:System.dll,System.Windows.Forms.dll,System.Drawing.dll src-launcher\\Program.cs",
    "build:release": "node scripts/build-release.js",
    "build:electron": "vite build && electron-builder",
    "cap:sync": "cap sync"
  },
  "dependencies": {
    "@capacitor/cli": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "@capacitor/ios": "^6.2.0",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "idb-keyval": "^6.2.1",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "happy-dom": "^21.0.4",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
