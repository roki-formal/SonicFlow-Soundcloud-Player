# SonicFlow Environment Configuration

# SoundCloud Public Client ID (optional - if omitted, legal public streaming resolver & fallback catalog is used)
VITE_SOUNDCLOUD_CLIENT_ID=your_soundcloud_client_id_here

# Optional: LRCLIB API endpoint for online lyrics fetching
VITE_LRCLIB_API_URL=https://lrclib.net/api

# App Settings
VITE_APP_NAME=SonicFlow
VITE_DEFAULT_THEME=midnight-black
